# Dyrhald website - settings for GoDaddy's Apache web server (cPanel hosting). Harmless if ignored.

# Show our own page for missing addresses
ErrorDocument 404 /404.html

# Make sure .webp images and .svg icons are served with the right type
AddType image/webp .webp
AddType image/svg+xml .svg

# Let browsers keep images, styles and scripts for a while, so pages load faster on repeat visits
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Compress text files on the way out
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
